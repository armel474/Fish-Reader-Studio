{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/actions/**",
              "components/badge/**",
              "components/banner/**",
              "components/history/**",
              "components/icon/**",
              "components/inputs/**",
              "components/navigation/**",
              "components/reader/**",
              "components/stats/**",
              "components/voices/**",
              "ui_kits/studio/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Literata|Source Sans 3))/i]",
        "message": "Font not provided by the design system. Available: Literata, Source Sans 3."
      },
      {
        "selector": "JSXOpeningElement[name.name='AppShell'] > JSXAttribute > JSXIdentifier[name!=/^(?:active|onNavigate|sidebarFooter|height|children|key|ref|className|style|children)$/]",
        "message": "<AppShell> doesn't accept that prop. Declared props: active, onNavigate, sidebarFooter, height, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='AppShell'] > JSXAttribute[name.name='active'] > Literal[value!=/^(?:accueil|studio|bibliotheque|voix|signets|statistiques)$/]",
        "message": "<AppShell> active must be one of 'accueil' | 'studio' | 'bibliotheque' | 'voix' | 'signets' | 'statistiques'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|children|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: tone, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:neutral|accent|highlight)$/]",
        "message": "<Badge> tone must be one of 'neutral' | 'accent' | 'highlight'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Banner'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|text|action|onAction|onClose|key|ref|className|style|children)$/]",
        "message": "<Banner> doesn't accept that prop. Declared props: title, text, action, onAction, onClose."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|icon|disabled|type|className|onClick|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, icon, disabled, type, className, onClick, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|ghost|on-accent)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'ghost' | 'on-accent'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:md|lg)$/]",
        "message": "<Button> size must be one of 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:button|submit)$/]",
        "message": "<Button> type must be one of 'button' | 'submit'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Chip'] > JSXAttribute > JSXIdentifier[name!=/^(?:selected|onClick|children|key|ref|className|style|children)$/]",
        "message": "<Chip> doesn't accept that prop. Declared props: selected, onClick, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|className|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|label|size|className|onClick|key|ref|className|style|children)$/]",
        "message": "<IconButton> doesn't accept that prop. Declared props: icon, label, size, className, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:md|lg)$/]",
        "message": "<IconButton> size must be one of 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='NavItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|label|count|active|onClick|key|ref|className|style|children)$/]",
        "message": "<NavItem> doesn't accept that prop. Declared props: icon, label, count, active, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='PlayerBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:playing|progress|elapsed|remaining|voice|speedControl|onToggle|onPrev|onNext|key|ref|className|style|children)$/]",
        "message": "<PlayerBar> doesn't accept that prop. Declared props: playing, progress, elapsed, remaining, voice, speedControl, onToggle, onPrev, onNext."
      },
      {
        "selector": "JSXOpeningElement[name.name='ReaderText'] > JSXAttribute > JSXIdentifier[name!=/^(?:paragraphs|active|onSeek|kicker|title|key|ref|className|style|children)$/]",
        "message": "<ReaderText> doesn't accept that prop. Declared props: paragraphs, active, onSeek, kicker, title."
      },
      {
        "selector": "JSXOpeningElement[name.name='SearchField'] > JSXAttribute > JSXIdentifier[name!=/^(?:placeholder|defaultValue|onChange|key|ref|className|style|children)$/]",
        "message": "<SearchField> doesn't accept that prop. Declared props: placeholder, defaultValue, onChange."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionLabel'] > JSXAttribute > JSXIdentifier[name!=/^(?:action|children|key|ref|className|style|children)$/]",
        "message": "<SectionLabel> doesn't accept that prop. Declared props: action, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Segmented'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|options|onChange|key|ref|className|style|children)$/]",
        "message": "<Segmented> doesn't accept that prop. Declared props: label, value, options, onChange."
      },
      {
        "selector": "JSXOpeningElement[name.name='SessionList'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|key|ref|className|style|children)$/]",
        "message": "<SessionList> doesn't accept that prop. Declared props: children."
      },
      {
        "selector": "JSXOpeningElement[name.name='SessionRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:time|title|excerpt|progress|key|ref|className|style|children)$/]",
        "message": "<SessionRow> doesn't accept that prop. Declared props: time, title, excerpt, progress."
      },
      {
        "selector": "JSXOpeningElement[name.name='Sidebar'] > JSXAttribute > JSXIdentifier[name!=/^(?:active|footer|onNavigate|key|ref|className|style|children)$/]",
        "message": "<Sidebar> doesn't accept that prop. Declared props: active, footer, onNavigate."
      },
      {
        "selector": "JSXOpeningElement[name.name='Sidebar'] > JSXAttribute[name.name='active'] > Literal[value!=/^(?:accueil|studio|bibliotheque|voix|signets|statistiques)$/]",
        "message": "<Sidebar> active must be one of 'accueil' | 'studio' | 'bibliotheque' | 'voix' | 'signets' | 'statistiques'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:stats|goal|key|ref|className|style|children)$/]",
        "message": "<StatCard> doesn't accept that prop. Declared props: stats, goal."
      },
      {
        "selector": "JSXOpeningElement[name.name='VoiceCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|lang|description|selected|onSelect|tag|seed|key|ref|className|style|children)$/]",
        "message": "<VoiceCard> doesn't accept that prop. Declared props: name, lang, description, selected, onSelect, tag, seed."
      },
      {
        "selector": "JSXOpeningElement[name.name='Wave'] > JSXAttribute > JSXIdentifier[name!=/^(?:seed|key|ref|className|style|children)$/]",
        "message": "<Wave> doesn't accept that prop. Declared props: seed."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
